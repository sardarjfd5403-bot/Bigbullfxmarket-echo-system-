# Copy to .env for local development. Never commit real credentials.
APP_ENV=development
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
LOG_LEVEL=INFO

# Licensed economic-calendar provider (optional until subscription is approved)
TRADING_ECONOMICS_API_KEY=replace_me
TRADING_ECONOMICS_NAIVE_TIMEZONE=UTC

# MT5 terminal installed on Windows and logged into an Exness DEMO account
MT5_TERMINAL_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe
